# Build-time settings for the hosted site. Copy to .env.production, or set the
# same names in the host's build environment (Cloudflare Pages: Settings →
# Variables and Secrets → Production).
#
# Vite bakes these into the JavaScript at build time, so every value here is
# public to anyone who opens the site. Nothing secret belongs in this file, and
# changing one means rebuilding, not just restarting.

# The API's origin, with no trailing slash. Leave empty only if the API is
# served from the same origin as the site.
VITE_API_BASE_URL=https://helpdesk-api--yourproject.code.run

# Demo sign-in shortcuts for the four roles, for a throwaway deployment only.
# These put a working password in public JavaScript, so never set them for a
# deployment holding anyone's real data.
# VITE_DEMO_MODE=true
# VITE_DEMO_PASSWORD=
