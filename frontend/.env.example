# Public configuration only. Everything prefixed VITE_ is compiled into the
# browser bundle and visible to anyone, so never put secrets here.

# Base URL of the HelpDesk API, without a trailing slash. Leave empty in
# development: the Vite dev server forwards /api to DEV_API_PROXY_TARGET.
VITE_API_BASE_URL=

# Development only: where the Vite dev server forwards /api requests.
DEV_API_PROXY_TARGET=http://localhost:8080

# Public demo only. When VITE_DEMO_MODE is "true" and a password is set, the
# landing and sign-in pages offer one-click demo accounts. Anything here is
# readable by every visitor, so use it only for a deployment holding
# throwaway data.
VITE_DEMO_MODE=false
VITE_DEMO_PASSWORD=
