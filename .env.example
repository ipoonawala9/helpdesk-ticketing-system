# Settings for `docker compose up`. Copy to .env (which git ignores) and fill in.
# Never commit real values.

# Password for the local PostgreSQL container.
DB_PASSWORD=

# Access-token signing key, at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# The first super admin, created on first start.
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@helpdesk.local
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# Browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
